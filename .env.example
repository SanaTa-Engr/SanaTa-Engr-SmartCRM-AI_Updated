# ==========================================
# SmartCRM AI — Environment Configuration
# ==========================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Automatically injected at runtime with the Cloud Run service URL or Vercel URL.
APP_URL="MY_APP_URL"

# SUPABASE_URL & ANON_KEY: Optional external Supabase project credentials.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# GOOGLE_MAPS_API_KEY: Google Maps Platform / Places API key
# ==============================================================================
# SECURITY NOTICE: NEVER commit your actual API key to GitHub!
#
# 1. Server-Side Protection (Recommended for Vercel):
#    Add GOOGLE_MAPS_API_KEY directly in Vercel:
#    Project Settings -> Environment Variables -> Add GOOGLE_MAPS_API_KEY
#    This keeps your key 100% private on the server. The server proxies Places
#    search requests and safely feeds configuration without exposing keys in Git.
#
# 2. Client-Side Browser Restriction (If using VITE_GOOGLE_MAPS_API_KEY):
#    If you configure VITE_GOOGLE_MAPS_API_KEY in Vercel environment variables,
#    open Google Cloud Console -> APIs & Services -> Credentials:
#    - Set Application Restrictions: "Websites / HTTP Referrers"
#    - Add: https://*.vercel.app/* and http://localhost:*
#    - Set API Restrictions: Restrict key only to "Maps JavaScript API"
# ==============================================================================
GOOGLE_MAPS_API_KEY="YOUR_KEY_IN_VERCEL_ENV_NOT_GIT"
