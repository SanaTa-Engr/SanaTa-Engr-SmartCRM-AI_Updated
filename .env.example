# ==========================================
# SmartCRM AI — Environment Configuration
# ==========================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
# Configured server-side in Vercel: Project Settings -> Environment Variables.
# Server-side TypeScript accesses this via process.env.GEMINI_API_KEY.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# Automatically set at runtime by Cloud Run or Vercel.
APP_URL=""

# GOOGLE_MAPS_API_KEY: Google Maps Platform / Places API key (SERVER-SIDE ONLY)
# ==============================================================================
# SECURITY ARCHITECTURE:
# Add GOOGLE_MAPS_API_KEY directly in Vercel:
# Project Settings -> Environment Variables -> Add GOOGLE_MAPS_API_KEY
# 
# This key is strictly private and used ONLY on the server via process.env.GOOGLE_MAPS_API_KEY
# to query the Google Places API (POST https://places.googleapis.com/v1/places:searchText).
# It is NEVER exposed to the browser, JavaScript bundles, or network responses.
# ==============================================================================
GOOGLE_MAPS_API_KEY=""

# VITE_GOOGLE_MAPS_BROWSER_KEY (OPTIONAL - Browser Only)
# ==============================================================================
# Separate client-side browser key used SOLELY for rendering interactive visual Google
# Maps tiles in the browser via @vis.gl/react-google-maps.
# 
# In Google Cloud Console -> APIs & Services -> Credentials, restrict this key:
# - Application Restrictions: "Websites / HTTP Referrers" (e.g. https://*.vercel.app/*)
# - API Restrictions: Restrict strictly to "Maps JavaScript API"
# 
# If not configured, the CRM lead discovery still functions fully using the built-in
# interactive spatial radar basemap.
# ==============================================================================
# VITE_GOOGLE_MAPS_BROWSER_KEY=""
